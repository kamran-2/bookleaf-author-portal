PORT=5000

# PostgreSQL — use a connection URL (local or hosted e.g. Neon, Supabase, Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/bookleaf

# For Neon with SSL:
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Anthropic (Claude) — optional; app works without it (AI features disabled gracefully)
ANTHROPIC_API_KEY=your_anthropic_api_key

# CORS — set to your frontend URL
FRONTEND_URL=http://localhost:3000
